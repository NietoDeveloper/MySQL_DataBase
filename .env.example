# Bootstrap/admin account — used ONLY to run migrations (the official
# MySQL image makes MYSQL_ROOT_PASSWORD the root account's password).
# Never point the application at this account.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=functional_db
MYSQL_PORT=3306

# Least-privilege LOGIN account the application actually connects as.
# Created by scripts/create_app_role.sh — generate a separate strong
# password for this one too (never reuse MYSQL_ROOT_PASSWORD).
APP_DB_PASSWORD=

# In any environment beyond local dev, also require TLS
# (--ssl-mode=REQUIRED or VERIFY_IDENTITY with a CA bundle) on every
# connection.
