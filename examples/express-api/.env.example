# Database connection (same account as ../../client/.env.example —
# the least-privilege app_user, never root)
DB_HOST=mysql
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=CHANGE_ME
DB_NAME=functional_db
DB_POOL_SIZE=10
DB_SSL=false

# API
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_TTL=15m
REFRESH_TTL_DAYS=30
