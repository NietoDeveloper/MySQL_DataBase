# Connection details for the LEAST-PRIVILEGE app account created by
# ../scripts/create_app_role.sh — never the root/bootstrap account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=CHANGE_ME
DB_NAME=functional_db

# Pool size — start at (CPU cores * 2..4) on the machine running your
# backend, then measure under real load and adjust. See docs/PERFORMANCE.md
# in the repo root for sizing guidance.
DB_POOL_SIZE=10

# Set to "true" once MySQL is reachable over TLS (any non-local
# environment). See ../scripts/generate_dev_certs.sh for local testing.
DB_SSL=false
